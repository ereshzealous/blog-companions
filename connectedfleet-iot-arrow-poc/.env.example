# ConnectedFleet POC — copy to `.env` and adjust. `.env` is git-ignored; never commit real credentials.

# --- Lab 01 (no Docker) -------------------------------------------------------
# Deterministic fixture seed. Changing it changes the fixture hash recorded in run manifests.
LAB01_SEED=20261009
# Comma-separated fixture sizes and batch sizes for `make lab-01`.
LAB01_SIZES=10000,100000
LAB01_BATCHES=100,1000,10000
LAB01_WARMUPS=1
LAB01_REPETITIONS=5

# --- Lab 02 / Lab 03 (Docker Compose stack) -----------------------------------
# Read by compose.yaml and by host-side lab orchestration (`uv run`). Local-development values only.
# Passwords appear inside connection URIs: keep them URL-safe (letters, digits, - _ .).
POSTGRES_USER=connectedfleet
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=connectedfleet
DEBEZIUM_PG_USER=cf_debezium
DEBEZIUM_PG_PASSWORD=change-me-local-only
MONGO_ROOT_USER=connectedfleet
MONGO_ROOT_PASSWORD=change-me-local-only
MONGO_APP_USER=cf_app
MONGO_APP_PASSWORD=change-me-local-only
MONGO_DEBEZIUM_USER=cf_debezium
MONGO_DEBEZIUM_PASSWORD=change-me-local-only
CLICKHOUSE_USER=connectedfleet
CLICKHOUSE_PASSWORD=change-me-local-only

# Host view of the stack (containers get service names from compose.yaml instead).
KAFKA_BOOTSTRAP=localhost:9092
CONNECT_URL=http://localhost:8083
CLICKHOUSE_HTTP_URL=http://localhost:8123
POSTGRES_HOST=localhost
MONGO_HOST=localhost:27017

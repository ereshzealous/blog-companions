# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
build/
dist/

# Local configuration and secrets
.env
*.local

# Raw / bulky benchmark output. Curated summaries are committed explicitly.
benchmarks/results/**/raw/
benchmarks/results/**/*.log
*.arrow
*.arrows
*.parquet

# Container volumes and generated data
.data/
volumes/

# OS / editor
.DS_Store
.idea/
.vscode/

# Never commit editorial/publishing assets into this repository
*.pdf
*.html
!docs/**/*.html
# generated results pages (make results-html) are curated evidence
!benchmarks/results/**/*.html

# Keep authoring, agent settings and machine-local captures out of this companion.
.env.*
!.env.example
.agents/
.codex/
.claude/
AGENTS.md
CLAUDE.md
editorial/
medium-export/
html-export/
local-artifacts/
work-state/
*.zip
*.jfr
*.hprof
benchmarks/captures/


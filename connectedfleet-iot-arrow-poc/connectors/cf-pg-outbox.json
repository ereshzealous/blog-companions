{
  "name": "cf-pg-outbox",
  "config": {
    "_doc": "Debezium PostgreSQL CDC for outbox_event + Outbox Event Router. https://debezium.io/documentation/reference/3.6/transformations/outbox-event-router.html",
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "{{ENV:DEBEZIUM_PG_USER}}",
    "database.password": "{{ENV:DEBEZIUM_PG_PASSWORD}}",
    "database.dbname": "{{ENV:POSTGRES_DB}}",
    "plugin.name": "pgoutput",
    "publication.autocreate.mode": "disabled",
    "topic.prefix": "cfraw.pgoutbox",
    "slot.name": "cf_outbox_slot",
    "publication.name": "cf_outbox_pub",
    "table.include.list": "public.outbox_event",
    "_doc_snapshot": "no_data: start streaming without replaying pre-existing outbox rows. VERIFY: snapshot.mode value name in 3.6 (no_data replaced schema_only in 2.x).",
    "snapshot.mode": "no_data",
    "tombstones.on.delete": "false",
    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.table.field.event.id": "id",
    "transforms.outbox.table.field.event.key": "aggregateid",
    "transforms.outbox.table.field.event.payload": "payload",
    "transforms.outbox.route.by.field": "aggregatetype",
    "transforms.outbox.route.topic.replacement": "cfraw.outbox.${routedByValue}",
    "transforms.outbox.table.expand.json.payload": "true",
    "_doc_placement": "column:placement:alias; envelope placement wraps the value as {payload, eventId, eventType, occurredAt}. VERIFY envelope shape against a live message.",
    "transforms.outbox.table.fields.additional.placement": "id:envelope:eventId,type:envelope:eventType,occurred_at:envelope:occurredAt",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "topic.creation.default.replication.factor": "1",
    "topic.creation.default.partitions": "3"
  }
}
